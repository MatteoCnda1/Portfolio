---
import Base from '@/layouts/Base.astro';
import { path } from '@/i18n';
---

<Base lang="fr" title="Page introuvable" description="Cette page n’existe pas ou a été déplacée." altPath={path('home', 'en')} compactFooter>
  <section class="wrap nf">
    <p class="mono nf__code">Erreur 404 — Not found</p>
    <h1 class="display nf__title" data-reveal="line">
      <span class="line"><span>Hors</span></span>
      <span class="line"><span class="it">réseau.</span></span>
    </h1>
    <p class="nf__text">Cette page n’existe pas ou a été déplacée. <span lang="en">This page doesn’t exist or has moved.</span></p>
    <div class="nf__cta">
      <a class="btn" href="/">Retour à l’accueil</a>
      <a class="btn btn--ghost" href="/en/" lang="en">Back home</a>
    </div>
  </section>
</Base>

<style>
  .nf { padding-top: calc(var(--nav-h) + clamp(48px, 10vw, 160px)); padding-bottom: clamp(64px, 10vw, 160px); }
  .nf__code { color: var(--ink-3); margin-bottom: 24px; }
  .nf__title { font-size: clamp(4rem, 1rem + 13vw, 13rem); }
  .nf__text { margin-top: 36px; max-width: 46ch; color: var(--ink-2); font-size: var(--fs-lead); line-height: 1.45; }
  .nf__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
</style>
