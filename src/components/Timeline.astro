---
import { timeline } from '@/data/about';
import { projectPath, type Lang } from '@/i18n';
import { typo } from '@/lib/typo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const see = { fr: 'Voir le projet', en: 'See the project' };
---

<ol class="tl" role="list">
  {timeline.map((item) => (
    <li class="tl__item" data-reveal>
      <div class="tl__aside">
        <p class="tl__when">{item.when[lang]}</p>
        <p class="tl__kind">{item.kind[lang]}</p>
      </div>
      <div class="tl__body">
        <h3 class="tl__title" set:html={typo(item.title[lang], lang)} />
        <p class="tl__text" set:html={typo(item.text[lang], lang)} />
        {item.href && (
          <a class="arrow-link" href={projectPath(item.href, lang)}><span>{see[lang]}</span><span>→</span></a>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .tl { margin: 0; padding: 0; border-bottom: 1px solid var(--filet); }
  .tl__item {
    display: grid;
    grid-template-columns: minmax(0, 130px) minmax(0, 1fr);
    gap: 8px 28px;
    padding-block: 26px;
    border-top: 1px solid var(--filet);
  }
  .tl__aside { display: grid; gap: 6px; align-content: start; }
  .tl__when { font-family: var(--f-mono); font-size: 0.8125rem; color: var(--lueur); }
  .tl__kind {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--creme-3);
  }
  .tl__body { display: grid; gap: 8px; justify-items: start; }
  .tl__title { font-family: var(--f-display); font-size: var(--fs-h4); line-height: 1.1; }
  .tl__text { font-size: 0.9375rem; color: var(--creme-2); max-width: 56ch; }
  .tl__body .arrow-link { margin-top: 6px; }

  @media (max-width: 480px) {
    .tl__item { grid-template-columns: 1fr; }
  }
</style>
