---
import CopyButton from '@/components/CopyButton';
import { ui, type Lang } from '@/i18n';
import { person, socials } from '@/data/site';
import { typo } from '@/lib/typo';

interface Props { lang: Lang; compact?: boolean }
const { lang, compact = false } = Astro.props;
const year = new Date().getFullYear();
const t = {
  index: { fr: 'Contact', en: 'Contact' },
  title: { fr: ['Parlons', 'infrastructure.'], en: ["Let's talk", 'infrastructure.'] },
  intro: {
    fr: 'Une question, un projet ou simplement envie d’échanger ? Je suis à votre écoute — réponse sous 24 à 48 h.',
    en: 'A question, a project or just want to chat? I’m all ears — replies within 24–48h.',
  },
  univ: { fr: 'Email universitaire', en: 'University email' },
  main: { fr: 'Email', en: 'Email' },
};
const mails = [
  { label: t.main[lang], addr: person.email },
  { label: t.univ[lang], addr: person.emailUniv },
];
---

<footer class="footer" id="contact-cta">
  {!compact && (
    <section class="cta" aria-labelledby="cta-title">
      <div class="wrap">
        <p class="cta__index mono">{t.index[lang]}</p>
        <h2 id="cta-title" class="cta__title display" data-reveal>
          {t.title[lang][0]}<br /><em>{t.title[lang][1]}</em>
        </h2>
        <div class="cta__row">
          <p class="cta__intro" set:html={typo(t.intro[lang], lang)} />
          <div class="cta__list">
            {mails.map((m) => (
              <div class="mail">
                <div class="mail__text">
                  <span class="mail__label">{m.label}</span>
                  <a class="mail__addr" href={`mailto:${m.addr}`} set:html={m.addr.replace('@', '@<wbr>')} />
                </div>
                <CopyButton client:visible value={m.addr} label={ui.copyLabel[lang]} copyText={ui.copy[lang]} copiedText={ui.copied[lang]} />
              </div>
            ))}
            <ul class="cta__links" role="list">
              {socials.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener">
                    {typeof s.label === 'string' ? s.label : s.label[lang]} <span aria-hidden="true">↗</span>
                    <span class="sr-only">{ui.newTab[lang]}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  <div class="base wrap">
    <span>© {year} {person.name} · {ui.rights[lang]}</span>
    <span>{ui.location[lang]} · {person.coords}</span>
    <a href="#main" class="base__top">{ui.backToTop[lang]} ↑</a>
  </div>
</footer>

<style>
  .footer { margin-top: auto; }

  /* La seule lueur de la page, en bas à gauche, comme l'écran dans l'illustration. */
  .cta {
    padding-block: clamp(72px, 10vw, 140px) clamp(48px, 6vw, 80px);
    border-top: 1px solid var(--filet);
    background: radial-gradient(ellipse 60% 75% at 12% 100%, rgb(242 194 123 / 0.16), rgb(242 194 123 / 0) 70%);
  }
  .cta__index { color: var(--lueur); }
  .cta__title {
    margin: 20px 0 clamp(36px, 5vw, 64px);
    font-size: clamp(4rem, 13vw, 13rem);
  }
  .cta__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
  }
  .cta__intro { flex: 0 1 380px; color: var(--creme-2); }
  .cta__list { flex: 1 1 460px; max-width: 660px; display: grid; }
  .mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    padding-block: 18px;
    border-top: 1px solid var(--filet);
  }
  .mail__text { display: grid; gap: 4px; min-width: 0; }
  .mail__label {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--creme-3);
  }
  .mail__addr {
    font-family: var(--f-display);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.15;
    overflow-wrap: anywhere;
    transition: color var(--t-fast) var(--ease-out);
  }
  .mail__addr:hover { color: var(--lueur); }
  .cta__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin: 0;
    padding-top: 20px;
    border-top: 1px solid var(--filet);
    font-size: 0.9375rem;
  }
  .cta__links a { transition: color var(--t-fast) var(--ease-out); }
  .cta__links a:hover { color: var(--lueur); }

  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 24px 32px;
    border-top: 1px solid var(--filet);
    font-family: var(--f-mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.04em;
    color: var(--creme-3);
  }
  .base__top { color: var(--creme-2); transition: color var(--t-fast) var(--ease-out); }
  .base__top:hover { color: var(--lueur); }
</style>
