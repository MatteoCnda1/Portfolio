---
import { Image } from 'astro:assets';
import { tagLabel, type Project } from '@/data/projects';
import { projectPath, type Lang } from '@/i18n';

interface Props { project: Project; lang: Lang }
const { project: p, lang } = Astro.props;
const href = projectPath(p.slug, lang);
const read = { fr: 'Lire l’étude de cas', en: 'Read the case study' };
---

<article class="feat hover-zoom" data-reveal>
  <div class:list={['feat__media', 'plate', { 'plate--contain': p.fit === 'contain' }]}>
    <Image
      src={p.image}
      alt=""
      sizes="(max-width: 900px) 100vw, 50vw"
      widths={[480, 800, 1200, 1600]}
      format="webp"
      quality={78}
      style={p.position ? `object-position:${p.position}` : undefined}
    />
  </div>

  <div class="feat__body">
    <p class="feat__meta mono">{p.category[lang]} · {p.context[lang]}</p>
    <h3 class="feat__title">
      <a href={href} class="feat__link" data-curtain={p.short[lang]}>{p.short[lang]}</a>
    </h3>
    <p class="feat__summary">{p.summary[lang]}</p>
    <ul class="tags">
      {p.cardTags.map((t) => <li class="tag">{tagLabel(t, lang)}</li>)}
    </ul>
    <span class="arrow-link feat__cta" aria-hidden="true"><span>{read[lang]}</span><span>→</span></span>
  </div>
</article>

<style>
  .feat {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    padding-block: clamp(28px, 4vw, 48px);
    border-top: 1px solid var(--filet);
  }

  /* Lien étendu : toute la carte est cliquable, un seul arrêt clavier */
  .feat__link::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .feat__link:focus-visible { outline: none; }
  .feat:has(.feat__link:focus-visible) { outline: 2px solid var(--lueur); outline-offset: 8px; border-radius: 4px; }

  .feat__media { aspect-ratio: 16 / 10; }
  .feat__body { display: grid; gap: 18px; max-width: 560px; justify-items: start; }
  .feat__meta { color: var(--lueur); }
  .feat__title {
    font-family: var(--f-display);
    font-size: clamp(2rem, 3.4vw, 2.85rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }
  .feat__summary { color: var(--creme-2); }
  .feat:hover .feat__cta { color: var(--lueur); border-color: var(--lueur); }
  .feat:hover .feat__cta span:last-child { transform: translateX(4px); }
</style>
