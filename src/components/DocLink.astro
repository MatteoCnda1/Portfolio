---
import { statSync } from 'node:fs';
import { join } from 'node:path';
import type { Doc } from '@/data/projects';
import { ui, type Lang } from '@/i18n';
import { typo } from '@/lib/typo';

interface Props { doc: Doc; lang: Lang }
const { doc, lang } = Astro.props;
const href = `/${doc.href.replace(/^\//, '')}`;
let size = '';
try {
  const bytes = statSync(join(process.cwd(), 'public', href)).size;
  size = `${(bytes / 1024 / 1024).toFixed(1).replace('.', lang === 'fr' ? ',' : '.')} ${lang === 'fr' ? 'Mo' : 'MB'}`;
} catch {
  /* taille indisponible : on n'affiche rien */
}
---

<a class="doc" href={href} target="_blank" rel="noopener">
  <span class="doc__type mono">PDF{size && ` · ${size}`}</span>
  <span class="doc__title" set:html={typo(doc.title[lang], lang)} />
  <span class="doc__text" set:html={typo(doc.text[lang], lang)} />
  <span class="doc__arrow" aria-hidden="true">↗</span>
  <span class="sr-only">{ui.newTab[lang]}</span>
</a>

<style>
  .doc {
    display: grid;
    grid-template-columns: 9rem 1fr auto;
    grid-template-areas: 'type title arrow' 'type text arrow';
    column-gap: var(--col-gap);
    align-items: baseline;
    padding-block: 22px;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line-2);
    margin-top: 2em;
  }
  .doc + .doc { margin-top: 0; border-top: 0; }
  .doc__type { grid-area: type; color: var(--ink-3); }
  .doc__title {
    grid-area: title;
    font-family: var(--f-display);
    font-size: var(--fs-h4);
    letter-spacing: -0.015em;
    transition: color var(--t-fast) var(--ease-out);
  }
  .doc__text { grid-area: text; color: var(--ink-2); font-size: var(--fs-sm); }
  .doc__arrow { grid-area: arrow; align-self: center; font-size: 1.4rem; transition: transform 450ms var(--ease-out); }
  .doc:hover .doc__title { color: var(--accent); }
  .doc:hover .doc__arrow { transform: translate(4px, -4px); }
  @media (max-width: 640px) {
    .doc { grid-template-columns: 1fr auto; grid-template-areas: 'type arrow' 'title arrow' 'text arrow'; row-gap: 4px; }
  }
</style>
