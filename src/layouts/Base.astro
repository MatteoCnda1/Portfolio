---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/jetbrains-mono/index.css';
import '@fontsource/spline-sans/400.css';
import '@fontsource/spline-sans/500.css';
import '@/styles/global.css';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import frauncesItalicUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-italic.woff2?url';

import Nav from '@/components/Nav';
import Footer from '@/components/Footer.astro';
import { htmlLang, ogLocale, otherLang, path, ui, type Lang, type RouteKey } from '@/i18n';
import { person } from '@/data/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Page courante dans la navigation (null = aucune) */
  current?: RouteKey | null;
  /** Chemin équivalent dans l'autre langue */
  altPath: string;
  image?: string;
  compactFooter?: boolean;
}

const { lang, title, description, current = null, altPath, image = '/og.png', compactFooter = false } = Astro.props;
const other = otherLang(lang);
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const alternate = new URL(altPath, site).href;
const fullTitle = current === 'home' ? `${person.name} — ${ui.role[lang]}` : `${title} — ${person.name}`;
const ogImage = new URL(image, site).href;

const navLinks = (['projects', 'about', 'contact'] as const).map((key) => ({
  key,
  href: path(key, lang),
  label: ui.nav[key][lang],
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  url: new URL(path('home', lang), site).href,
  jobTitle: lang === 'fr' ? 'Étudiant en BUT Réseaux & Télécoms — cybersécurité' : 'Networks & Telecoms student — cybersecurity',
  address: { '@type': 'PostalAddress', addressLocality: 'Marseille', addressCountry: 'FR' },
  sameAs: [person.linkedin, person.github],
  knowsAbout: ['Networking', 'Cybersecurity', 'Linux', 'Ansible', 'Embedded systems', 'BLE'],
};
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={htmlLang[lang]} href={canonical} />
    <link rel="alternate" hreflang={htmlLang[other]} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={lang === 'fr' ? canonical : alternate} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesItalicUrl} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      /* États cachés des reveals seulement si JS tourne ; filet de sécurité si le module motion ne se charge pas. */
      (function (d) {
        d.classList.add('js');
        setTimeout(function () { if (!d.dataset.motion) d.classList.add('motion-failed'); }, 3000);
      })(document.documentElement);
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skip[lang]}</a>
    <Nav
      client:load
      lang={lang}
      current={current}
      links={navLinks}
      homeHref={path('home', lang)}
      altHref={altPath}
      altLang={other}
      altLabel={ui.nav.switchTo[lang]}
      email={person.email}
      socials={[
        { label: 'LinkedIn', href: person.linkedin },
        { label: 'GitHub', href: person.github },
      ]}
    />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} altPath={altPath} compact={compactFooter} />
    <script>
      import '@/scripts/motion';
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }
</style>
