---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Featured from '@/components/Featured.astro';
import Timeline from '@/components/Timeline.astro';
import ProjectIndex from '@/components/ProjectIndex';
import { featured, img, projects } from '@/data/projects';
import { indexItems } from '@/lib/index-items';
import { path, ui, type Lang } from '@/i18n';
import { person } from '@/data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const night = img('assets/nuit-laptop.jpg');
const items = await indexItems(lang);

const t = {
  description: {
    fr: 'Mattéo Canada — étudiant en BUT Réseaux & Télécoms, parcours cybersécurité, alternant au D@TA-i (Police Nationale). Infrastructures réseau, sécurité, automatisation et embarqué.',
    en: 'Mattéo Canada — Networks & Telecoms student on the cybersecurity track, work-study at D@TA-i (French National Police). Network infrastructure, security, automation and embedded systems.',
  },
  statement: {
    fr: 'Étudiant en 3ᵉ année de BUT Réseaux & Télécoms, parcours cybersécurité, et alternant au D@TA-i — Police Nationale. Je conçois, sécurise et automatise des infrastructures, du routage OSPF au bastion Teleport.',
    en: 'Third-year Networks & Telecoms student on the cybersecurity track, and work-study apprentice at D@TA-i — French National Police. I design, secure and automate infrastructure, from OSPF routing to a Teleport bastion.',
  },
  heroAlt: {
    fr: 'De nuit, sur une crête au-dessus des nuages, une silhouette assise travaille sur un ordinateur portable, seule source de lumière.',
    en: 'At night, on a ridge above the clouds, a seated figure works on a laptop, the only source of light.',
  },
  seeWork: { fr: 'Voir les travaux', en: 'See the work' },
  contact: { fr: 'Me contacter', en: 'Get in touch' },
  proofsLabel: { fr: 'Repères', en: 'Highlights' },
  selectedTitle: { fr: ['Travaux', 'choisis'], en: ['Selected', 'work'] },
  allCount: { fr: `Les ${projects.length} projets →`, en: `All ${projects.length} projects →` },
  indexTitle: { fr: ['Tous les', 'projets'], en: ['Every', 'project'] },
  indexCount: { fr: `${projects.length} projets`, en: `${projects.length} projects` },
  journeyTitle: { fr: ['Le', 'parcours'], en: ['The', 'journey'] },
  journeyLead: {
    fr: 'Du plus récent au tout premier projet — chaque étape a préparé la suivante.',
    en: 'From the latest step back to the very first project — each one prepared the next.',
  },
};

const proofs = [
  { value: { fr: '1ᵉʳ', en: '1st' }, label: { fr: 'France — Cisco EMEA Cup', en: 'France — Cisco EMEA Cup' }, sub: { fr: '4ᵉ Europe · 5ᵉ EMEA', en: '4th Europe · 5th EMEA' } },
  { value: { fr: 'CSNA', en: 'CSNA' }, label: { fr: 'Certifié Stormshield', en: 'Stormshield certified' }, sub: { fr: 'Administrateur réseau', en: 'Network administrator' } },
  { value: { fr: 'CCNA 1—3', en: 'CCNA 1—3' }, label: { fr: 'Cisco Networking Academy', en: 'Cisco Networking Academy' }, sub: { fr: 'CCNP ENCOR en préparation', en: 'CCNP ENCOR in progress' } },
  { value: { fr: 'D@TA-i', en: 'D@TA-i' }, label: { fr: 'Alternance — Police Nationale', en: 'Work-study — National Police' }, sub: { fr: 'Réseaux & systèmes', en: 'Networks & systems' } },
];
---

<Base
  lang={lang}
  title={person.name}
  description={t.description[lang]}
  current="home"
  altPath={path('home', lang === 'fr' ? 'en' : 'fr')}
>
  <!-- Hero : l'illustration couvre le premier écran, le nom se pose en bas. Rendu côté serveur, visible sans JS. -->
  <section id="top" class="hero" aria-labelledby="hero-name">
    <div class="hero__media" data-hero-media>
      <Image
        src={night}
        alt={t.heroAlt[lang]}
        widths={[640, 960, 1280, 1703]}
        sizes="114vw"
        format="webp"
        quality={74}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__content">
      <div class="hero__row">
        <p class="hero__meta mono">
          <span class="hero__role">{ui.role[lang]}</span>
          <span>{ui.location[lang]} — {person.coords.replace(' — ', ' ')}</span>
        </p>
        <div class="hero__intro">
          <p>{t.statement[lang]}</p>
          <div class="hero__cta">
            <a class="btn" href="#travaux">{t.seeWork[lang]}<span class="btn__icon" aria-hidden="true">↓</span></a>
            <a class="btn btn--ghost" href="#contact-cta">{t.contact[lang]}</a>
          </div>
        </div>
      </div>
      <h1 id="hero-name" class="hero__name">{person.name}</h1>
    </div>
  </section>

  <section class="wrap proofs" aria-label={t.proofsLabel[lang]}>
    <dl class="proofs__grid" data-reveal>
      {proofs.map((p) => (
        <div class="proof">
          <dt class="proof__value">{p.value[lang]}</dt>
          <dd class="proof__label">{p.label[lang]}</dd>
          <dd class="proof__sub">{p.sub[lang]}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="travaux" class="section wrap" aria-labelledby="selected-title">
    <header class="section-head" data-reveal>
      <h2 id="selected-title" class="section-head__title h2">{t.selectedTitle[lang][0]} <em>{t.selectedTitle[lang][1]}</em></h2>
      <a class="section-head__aside" href="#index">{t.allCount[lang]}</a>
    </header>
    <div>
      {featured.map((p) => <Featured project={p} lang={lang} />)}
    </div>
  </section>

  <section id="index" class="section wrap" aria-labelledby="index-title">
    <header class="section-head" data-reveal>
      <h2 id="index-title" class="section-head__title h2">{t.indexTitle[lang][0]} <em>{t.indexTitle[lang][1]}</em></h2>
      <span class="section-head__index mono">{t.indexCount[lang]}</span>
    </header>
    <ProjectIndex client:visible items={items} />
  </section>

  <section id="parcours" class="section wrap journey" aria-labelledby="journey-title">
    <div class="journey__head">
      <h2 id="journey-title" class="h2">{t.journeyTitle[lang][0]} <em>{t.journeyTitle[lang][1]}</em></h2>
      <p class="journey__lead">{t.journeyLead[lang]}</p>
    </div>
    <Timeline lang={lang} />
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 480px;
    overflow: hidden;
    background: var(--nuit);
  }
  /* Débord de 7 % : la parallaxe (défilement + souris, voir motion.ts) ne découvre jamais les bords. */
  .hero__media {
    position: absolute;
    inset: -7%;
    will-change: transform;
  }
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 55%;
  }
  /* Le texte reste dans les zones sombres ; le dernier tiers rejoint --nuit et assoit le nom. */
  .hero__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(11 15 23 / 0.6) 0%, rgb(11 15 23 / 0) 20%, rgb(11 15 23 / 0) 44%, rgb(11 15 23 / 0.8) 78%, var(--nuit) 100%);
  }
  .hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 var(--gutter) clamp(10px, 1.4vw, 22px);
  }
  .hero__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px 48px;
    margin-bottom: clamp(10px, 1.6vw, 24px);
  }
  .hero__meta { display: grid; gap: 6px; color: var(--creme-2); }
  .hero__role { color: var(--creme); }
  .hero__intro { max-width: 400px; display: grid; gap: 18px; }
  .hero__intro p { font-size: 0.9375rem; line-height: 1.55; }
  .hero__cta { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  .hero__name {
    margin-left: -0.03em;
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-display);
    line-height: 0.82;
    letter-spacing: -0.02em;
  }

  /* ---------- Repères ---------- */
  .proofs { padding-top: clamp(56px, 8vw, 112px); }
  .proofs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 32px 28px;
    margin: 0;
  }
  .proof { display: grid; gap: 8px; align-content: start; padding-top: 20px; border-top: 1px solid var(--filet); }
  .proof dd { margin: 0; }
  .proof__value { font-family: var(--f-display); font-size: clamp(2.75rem, 4vw, 3.75rem); line-height: 1; }
  .proof__label { font-size: 0.9375rem; }
  .proof__sub { font-family: var(--f-mono); font-size: var(--fs-mono); letter-spacing: 0.04em; color: var(--creme-3); }

  /* ---------- Parcours : titre collant à gauche, étapes à droite ---------- */
  .journey {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 40px clamp(32px, 6vw, 96px);
  }
  .journey__head { flex: 1 1 300px; display: grid; gap: 20px; }
  .journey__lead { max-width: 34ch; color: var(--creme-2); }
  .journey > :global(.tl) { flex: 2 1 520px; }
  @media (min-width: 761px) {
    .journey__head { position: sticky; top: 110px; }
  }
</style>
