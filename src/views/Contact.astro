---
import Base from '@/layouts/Base.astro';
import CopyButton from '@/components/CopyButton';
import Trace from '@/components/Trace.astro';
import { otherLang, path, ui, type Lang } from '@/i18n';
import { person } from '@/data/site';
import { typo } from '@/lib/typo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = {
  description: {
    fr: 'Contacter Mattéo Canada : email, email universitaire, LinkedIn et GitHub. Basé à Marseille, disponible pour collaborer.',
    en: 'Get in touch with Mattéo Canada: email, university email, LinkedIn and GitHub. Based in Marseille, open to collaborate.',
  },
  title: { fr: ['Parlons', 'infrastructure.'], en: ["Let's talk", 'infrastructure.'] },
  intro: {
    fr: 'Une question, un projet ou simplement envie d’échanger ? Je suis à votre écoute.',
    en: 'A question, a project or just want to chat? I’m all ears.',
  },
  email: { fr: 'Email', en: 'Email' },
  univ: { fr: 'Email universitaire', en: 'University email' },
  networks: { fr: 'Réseaux', en: 'Profiles' },
  kb: { fr: 'Base de connaissances', en: 'Knowledge base' },
  where: { fr: 'Localisation', en: 'Location' },
  status: { fr: 'Statut', en: 'Status' },
  available: { fr: 'Disponible pour collaborer', en: 'Available to collaborate' },
  response: { fr: 'Temps de réponse moyen', en: 'Average response time' },
  responseValue: { fr: '24 — 48 h', en: '24 — 48h' },
};
const links = [
  { label: 'LinkedIn', href: person.linkedin },
  { label: 'GitHub', href: person.github },
  { label: t.kb[lang], href: person.knowledgeBase },
];
---

<Base lang={lang} title={ui.nav.contact[lang]} description={t.description[lang]} current="contact" altPath={path('contact', otherLang(lang))} compactFooter>
  <section class="wrap contact">
    <p class="mono contact__index" data-reveal>{ui.nav.contact[lang]}</p>
    <h1 class="contact__title display" data-reveal="line">
      <span class="line"><span>{t.title[lang][0]}</span></span>
      <span class="line"><span class="it">{t.title[lang][1]}</span></span>
    </h1>
    <p class="contact__intro" data-reveal set:html={typo(t.intro[lang], lang)} />

    <div class="rows" data-reveal-group>
      <div class="row row--mail" data-reveal>
        <span class="row__label mono">{t.email[lang]}</span>
        <a class="row__value row__value--big" href={`mailto:${person.email}`} set:html={person.email.replace('@', '@<wbr>')} />
        <CopyButton client:visible value={person.email} label={ui.copyLabel[lang]} copyText={ui.copy[lang]} copiedText={ui.copied[lang]} />
      </div>
      <div class="row row--mail" data-reveal>
        <span class="row__label mono">{t.univ[lang]}</span>
        <a class="row__value row__value--big" href={`mailto:${person.emailUniv}`} set:html={person.emailUniv.replace('@', '@<wbr>')} />
        <CopyButton client:visible value={person.emailUniv} label={ui.copyLabel[lang]} copyText={ui.copy[lang]} copiedText={ui.copied[lang]} />
      </div>
      <div class="row" data-reveal>
        <span class="row__label mono">{t.networks[lang]}</span>
        <ul class="row__links" role="list">
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener">
                {l.label} <span aria-hidden="true">↗</span><span class="sr-only">{ui.newTab[lang]}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <Trace nodes={3} live class="contact__trace" />
    <dl class="facts" data-reveal-group>
      <div data-reveal><dt class="mono">{t.where[lang]}</dt><dd>{ui.location[lang]}<span class="mono muted">{person.coords}</span></dd></div>
      <div data-reveal><dt class="mono">{t.status[lang]}</dt><dd><span class="dot" aria-hidden="true"></span>{t.available[lang]}</dd></div>
      <div data-reveal><dt class="mono">{t.response[lang]}</dt><dd>{t.responseValue[lang]}</dd></div>
    </dl>
  </section>
</Base>

<style>
  .contact { padding-top: calc(var(--nav-h) + clamp(48px, 9vw, 140px)); padding-bottom: clamp(64px, 9vw, 140px); }
  .contact__index { color: var(--ink-3); margin-bottom: 24px; }
  .contact__title { font-size: clamp(3.4rem, 1rem + 10.5vw, 11.5rem); }
  .contact__intro {
    max-width: 38ch;
    margin: clamp(28px, 4vw, 48px) 0 clamp(48px, 7vw, 96px) auto;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--ink-2);
  }
  .rows { border-top: 1px solid var(--ink); }
  .row {
    display: grid;
    grid-template-columns: minmax(150px, 3fr) 7fr auto;
    align-items: center;
    gap: 10px 24px;
    padding-block: clamp(18px, 2.4vw, 30px);
    border-bottom: 1px solid var(--line-2);
  }
  .row__label { color: var(--ink-3); }
  .row__value--big {
    font-family: var(--f-display);
    font-weight: 350;
    font-size: clamp(1.35rem, 0.8rem + 2.4vw, 3rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
    transition: color var(--t-fast) var(--ease-out), transform 500ms var(--ease-out);
  }
  .row__value--big:hover { color: var(--accent); transform: translateX(6px); }
  .row__links { display: flex; flex-wrap: wrap; gap: 8px 36px; margin: 0; grid-column: 2 / -1; }
  .row__links a {
    display: inline-block;
    padding-block: 6px;
    font-family: var(--f-display);
    font-size: var(--fs-h4);
    transition: color var(--t-fast) var(--ease-out);
  }
  .row__links a:hover { color: var(--accent); }
  .row :global(.copy) {
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--ink-2);
    transition: border-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
  }
  .row :global(.copy:hover) { border-color: var(--ink); color: var(--ink); }
  .row :global(.copy__slot) { display: inline-grid; min-width: 7.5ch; overflow: hidden; }
  .row :global(.copy__slot > span) { grid-area: 1 / 1; white-space: nowrap; }

  .contact :global(.contact__trace) { margin-top: clamp(64px, 8vw, 120px); }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--col-gap);
    margin: 20px 0 0;
  }
  .facts dt { color: var(--ink-3); margin-bottom: 8px; }
  .facts dd { margin: 0; display: grid; gap: 4px; font-size: 1.05rem; }
  .facts dd:has(.dot) { display: flex; align-items: center; gap: 10px; }
  .dot { width: 7px; height: 7px; background: var(--accent); animation: pulse 2.4s var(--ease-in-out) infinite; }
  @keyframes pulse { 50% { opacity: 0.25; } }

  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr auto; row-gap: 6px; }
    .row__label { grid-column: 1; grid-row: 1; }
    .row :global(.copy) { grid-column: 2; grid-row: 1; }
    .row__value--big { grid-column: 1 / -1; grid-row: 2; font-size: clamp(1.2rem, 5.6vw, 2rem); }
    .row__links { grid-column: 1 / -1; }
    .contact__intro { margin-left: 0; }
    .facts { grid-template-columns: 1fr; row-gap: 24px; }
  }
</style>
